diff --git a/service/subscription_search.go b/service/subscription_search.go
new file mode 100644
--- /dev/null
+++ b/service/subscription_search.go
@@ -0,0 +1,99 @@
+package service
+
+import (
+	"context"
+	"fmt"
+	"strings"
+
+	"pansou/model"
+	"pansou/plugin"
+)
+
+// SearchComplete waits for each explicitly selected source. Unlike interactive
+// search it bypasses the short async response and never infers completion from
+// an unchanged result count. Successful sources survive a sibling's failure.
+func (s *SearchService) SearchComplete(ctx context.Context, keyword string, channels, plugins []string) (model.SearchResponse, error) {
+	return s.SearchCompleteClouds(ctx, keyword, channels, plugins, []string{"115", "magnet"})
+}
+
+func (s *SearchService) SearchCompleteClouds(ctx context.Context, keyword string, channels, plugins, clouds []string) (model.SearchResponse, error) {
+	accepted := map[string]bool{}
+	for _, cloud := range clouds {
+		accepted[strings.ToLower(cloud)] = true
+	}
+	type result struct {
+		items []model.SearchResult
+		err   error
+	}
+	tasks := []func() result{}
+	for _, channel := range channels {
+		tasks = append(tasks, func() result {
+			items, err := s.searchChannelWithContext(ctx, keyword, channel)
+			return result{items, err}
+		})
+	}
+	available := map[string]plugin.AsyncSearchPlugin{}
+	for _, p := range s.pluginManager.GetPlugins() {
+		available[p.Name()] = p
+	}
+	for _, name := range plugins {
+		tasks = append(tasks, func() result {
+			p, ok := available[name]
+			if !ok {
+				return result{err: fmt.Errorf("plugin unavailable: %s", name)}
+			}
+			items, err := p.Search(keyword, map[string]interface{}{
+				"_wait_complete": true, "refresh": true, "referer": "https://dm.xueximeng.com", plugin.ExtContextKey: ctx,
+			})
+			// Retain plugin identity even when its own results omit Channel.
+			for i := range items {
+				items[i].Channel = "plugin:" + name
+			}
+			return result{items, err}
+		})
+	}
+	results := make(chan result, len(tasks))
+	gate := make(chan struct{}, 12)
+	for _, task := range tasks {
+		go func() {
+			select {
+			case gate <- struct{}{}:
+			case <-ctx.Done():
+				results <- result{err: ctx.Err()}
+				return
+			}
+			defer func() { <-gate }()
+			results <- task()
+		}()
+	}
+	out := model.SearchResponse{}
+	failed := 0
+	for range tasks {
+		select {
+		case <-ctx.Done():
+			out.Total = len(out.Results)
+			return out, fmt.Errorf("PanSou 搜索未全部完成，等待补查: %w", ctx.Err())
+		case r := <-results:
+			if r.err != nil {
+				failed++
+			}
+			for _, item := range r.items {
+				links := []model.Link{}
+				for _, link := range item.Links {
+					if accepted[strings.ToLower(link.Type)] {
+						links = append(links, link)
+					}
+				}
+				item.Links = links
+				if len(links) > 0 {
+					out.Results = append(out.Results, item)
+				}
+			}
+		}
+	}
+	out.Total = len(out.Results)
+	if failed > 0 {
+		return out, fmt.Errorf("PanSou %d/%d 个来源失败，已保留其他结果，等待补查", failed, len(tasks))
+	}
+	return out, nil
+}
