@@ -0,0 +1,34 @@
+package plugin
+
+import (
+	"net/http"
+	"testing"
+	"time"
+
+	"pansou/model"
+)
+
+func TestSubscriptionWaitsBeyondInteractiveTimeout(t *testing.T) {
+	for _, rich := range []bool{false, true} {
+		t.Run(map[bool]string{false: "plain", true: "rich"}[rich], func(t *testing.T) {
+			t.Parallel()
+			p := &BaseAsyncPlugin{name: "subscription"}
+			search := func(*http.Client, string, map[string]interface{}) ([]model.SearchResult, error) {
+				time.Sleep(4200 * time.Millisecond)
+				return []model.SearchResult{{Title: "late episode"}}, nil
+			}
+			ext := map[string]interface{}{"_wait_complete": true}
+			if rich {
+				got, err := p.AsyncSearchWithResult("show", search, "", ext)
+				if err != nil || !got.IsFinal || len(got.Results) != 1 {
+					t.Fatalf("partial rich result: %+v %v", got, err)
+				}
+			} else {
+				got, err := p.AsyncSearch("show", search, "", ext)
+				if err != nil || len(got) != 1 {
+					t.Fatalf("partial result: %+v %v", got, err)
+				}
+			}
+		})
+	}
+}
diff --git a/service/subscription_search_test.go b/service/subscription_search_test.go
new file mode 100644
--- /dev/null
+++ b/service/subscription_search_test.go
@@ -0,0 +1,51 @@
+package service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"pansou/model"
+	"pansou/plugin"
+)
+
+type subscriptionPlugin struct {
+	*plugin.BaseAsyncPlugin
+	name  string
+	delay time.Duration
+	fail  bool
+}
+
+func (p *subscriptionPlugin) Name() string { return p.name }
+func (p *subscriptionPlugin) Search(_ string, ext map[string]interface{}) ([]model.SearchResult, error) {
+	if ext["_wait_complete"] != true {
+		return nil, errors.New("partial mode")
+	}
+	select {
+	case <-time.After(p.delay):
+	case <-plugin.ContextFromExt(ext).Done():
+		return nil, plugin.ContextFromExt(ext).Err()
+	}
+	if p.fail {
+		return nil, errors.New("unavailable")
+	}
+	return []model.SearchResult{{Title: p.name, Links: []model.Link{{Type: "115", URL: "https://115.com/s/" + p.name}}}}, nil
+}
+func TestSubscriptionSearchWaitsAndReportsFailure(t *testing.T) {
+	manager := plugin.NewPluginManager()
+	manager.RegisterPlugin(&subscriptionPlugin{name: "fast"})
+	manager.RegisterPlugin(&subscriptionPlugin{name: "slow", delay: 40 * time.Millisecond})
+	manager.RegisterPlugin(&subscriptionPlugin{name: "broken", fail: true})
+	s := &SearchService{pluginManager: manager}
+	got, err := s.SearchComplete(context.Background(), "show", nil, []string{"fast", "slow", "broken"})
+	if err == nil || len(got.Results) != 2 {
+		t.Fatalf("lost delayed result or failure: %+v %v", got, err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Millisecond)
+	defer cancel()
+	got, err = s.SearchComplete(ctx, "show", nil, []string{"fast", "slow"})
+	if err == nil || len(got.Results) != 1 {
+		t.Fatalf("timeout lost completed sources: %+v %v", got, err)
+	}
+}
